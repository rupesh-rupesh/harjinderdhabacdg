# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT (.env)
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is already in .gitignore.

# ─── Supabase Database ────────────────────────────────────────────────────────
# For LOCAL development: use the direct connection (port 5432)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:6543/postgres"

# ─── FOR VERCEL DEPLOYMENT ───────────────────────────────────────────────────
# ❌ The direct connection above (port 5432) is BLOCKED by Supabase from Vercel.
# ✅ Use the Transaction Pooler URL instead. Get it from:
#    Supabase Dashboard → Project Settings → Database → Connection Pooling → Transaction Mode
#
# The Transaction Pooler URL looks like:
# postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#
# Set this as DATABASE_URL in:
# Vercel Dashboard → Your Project → Settings → Environment Variables

# ─── Dashboard Security Passwords ────────────────────────────────────────────
# These are used to protect the Admin and Manager dashboards.
# Set strong, unique passwords here — NEVER use the defaults in production.
# Also add VITE_ prefixed versions so the client-side fallback uses them too.
#
# Server-side (read by api/handler.ts at runtime):
ADMIN_DASHBOARD_PASSWORD="your_secure_admin_password_here"
MANAGER_DASHBOARD_PASSWORD="your_secure_manager_password_here"
#
# Client-side Vite build (used as fallback in DashboardAuthModal when API is unreachable):
VITE_ADMIN_DASHBOARD_PASSWORD="your_secure_admin_password_here"
VITE_MANAGER_DASHBOARD_PASSWORD="your_secure_manager_password_here"

# ─── Staff Email+Password Auth ────────────────────────────────────────────────────────
# Generate hash: node -e "const b=require('bcryptjs'); console.log(b.hashSync('YourPass',12))"
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD_HASH="$2b$12$your_bcrypt_hash_here"

# ─── Email Sending (Resend) ─────────────────────────────────────────────────────
# Get from: https://resend.com → API Keys
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="Harjinder Dhaba <noreply@yourdomain.com>"

# ─── OTP Config ───────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
